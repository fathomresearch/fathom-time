# Copy this file to .env.local and fill in the values.
# Never commit .env.local to GitHub.

# Supabase > Project Settings > Data API: "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Supabase > Project Settings > API Keys: the "Publishable key" (starts with sb_publishable_)
# A legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Supabase > Project Settings > API Keys: a "Secret key" (starts with sb_secret_).
# Server only. Sign-in needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated. These people become boss the first time they sign in.
BOSS_EMAILS=admin@fathomresearch.ai

# Blank = anyone with a Google account can sign in.
# Set to a domain (e.g. fathomresearch.ai) to allow only that domain.
ALLOWED_EMAIL_DOMAIN=

# Used when a person hasn't picked a time zone yet.
DEFAULT_TIMEZONE=America/Chicago
