# Copy this file to .env.local and fill in the values. Never commit .env.local.
# The website only needs the two public values below; the same two are
# GitHub secrets for the publish job.

# Supabase > Project Settings > Data API: "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Supabase > Project Settings > API Keys: the "Publishable key" (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Who becomes Director on first sign-in is set in the database:
#   update public.app_settings set value = 'admin@fathomresearch.ai' where key = 'director_emails';
